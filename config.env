# KernelSU Action -- build profile
#
# Values here are defaults; workflow_dispatch inputs override them per run.
# Only the exact string "true" (or yes/on/1) counts as enabled.
#
# Copy this file to config/<device>.env to keep one profile per device, then
# pick it with the "Config file to build" input when you start a build.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/TianXiao203/android_kernel_xiaomi_sm8450
KERNEL_SOURCE_BRANCH=lineage-23.2
# Path is relative to arch/<ARCH>/configs/: build.sh both resolves the file
# there and hands the bare name to `make <name>_defconfig`.
KERNEL_CONFIG=unicorn_merged_defconfig

# Vendor config fragments, space separated, relative to the kernel tree root.
#
# unicorn_merged_defconfig is gki_defconfig plus a handful of device tweaks: it
# is the *core* only. The SM8450 (waipio) SoC options and the Xiaomi/unicorn
# device options live in arch/arm64/configs/vendor/*.config, which the ROM's own
# build merges on top. Without them this builds a kernel with no SoC support at
# all -- no UFS controller, no clocks, no regulators, no zram, no ARCH_WAIPIO --
# which compiles fine and then hangs on the first splash screen.
#
# This is the same list LineageOS's device tree passes as TARGET_KERNEL_CONFIG:
#   gki_defconfig  vendor/waipio_GKI.config  vendor/xiaomi_GKI.config
#   vendor/unicorn_GKI.config  vendor/debugfs.config
#
# debugfs.config is easy to overlook and it matters: gki_defconfig enables
# CONFIG_DEBUG_FS / CONFIG_PAGE_OWNER / CONFIG_PAGE_PINNER, and those add members
# to struct page. The ROM turns them back off, so leaving them on would move the
# CRCs of every exported symbol that takes a struct page *.
KERNEL_CONFIG_FRAGMENTS=arch/arm64/configs/vendor/waipio_GKI.config arch/arm64/configs/vendor/xiaomi_GKI.config arch/arm64/configs/vendor/unicorn_GKI.config arch/arm64/configs/vendor/debugfs.config

KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
# CONFIG_LOCALVERSION. Leave blank to derive it from KERNEL_CONFIG.
KERNEL_NAME=unicorn

ADD_LOCALVERSION_TO_FILENAME=false

# Extra flags appended to every make invocation. Values may contain "=".
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
#
# Verified working pairs as of 2026-07:
#   CLANG_BRANCH=main-kernel               CLANG_VERSION=r596125   (newest)
#   CLANG_BRANCH=main-kernel-2026          CLANG_VERSION=r584948c
#   CLANG_BRANCH=main-kernel-2025          CLANG_VERSION=r547379
#   CLANG_BRANCH=main-kernel-build-2024    CLANG_VERSION=r510928
#   CLANG_BRANCH=master-kernel-build-2022  CLANG_VERSION=r450784e
#
# 5.10 GKI tree: use r547379 or newer.
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Build fully with LLVM (LLVM=1 LLVM_IAS=1). Good for 5.10+.
USE_LLVM=true

# ===================================================================== GCC ==
#
# Not needed when USE_LLVM=true for 5.10+.
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
#
# resukisu is a re-fork of SukiSU-Ultra focused on legacy and non-GKI kernels,
# with multi-manager support. Works fine on 5.10 GKI too.
KSU_VARIANT=resukisu
KSU_REF=

# auto | kprobes | manual | tracepoint | syscall | none
KSU_HOOK_MODE=auto

# Custom manager APK signature. Leave blank for the official manager.
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# Keep off for the first build. Enable only after the base kernel boots and
# Docker works. Non-GKI/GKI-boundary trees often fail to apply SUSFS patches.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# path_umount() arrived in Linux 5.9, so 5.10 already has it. Leave off.
ENABLE_PATH_UMOUNT=false

# Extra fingerprint removal on top of SUSFS.
ENABLE_HIDE_STUFF=false

# SukiSU-Ultra's Kernel Patch Module support. arm64 only.
ENABLE_KPM=false

# ================================================================ Kconfig ===

# Kprobes is required by KernelSU's hook on 5.10.
ADD_KPROBES_CONFIG=true

# OverlayFS is required by Docker's default storage driver.
ADD_OVERLAYFS_CONFIG=true

DISABLE_LTO=false
DISABLE_CC_WERROR=false

# Container kernel options: Docker, Droidspaces, UFW, fail2ban.
#
# "Safe for the GKI ABI" is the qualifier that governs everything below, and it
# is not decoration. Android compiles the kernel and its vendor modules
# separately: each module records the CRC it expects for every kernel symbol it
# calls, genksyms derives those CRCs from the *type definitions*, and the kernel
# refuses to load a module whose CRCs differ. One changed struct layout
# therefore invalidates hundreds of them -- and when the display driver is among
# the casualties the screen is never handed over, so the device sits on the Mi
# logo for ever with no panic, no dmesg and an empty pstore.
#
# Everything enabled here was either bisected and ABI-verified on this device
# (project TianXiao203/12sp, configs/docker-cgroup.fragment) or is a leaf option
# no exported symbol's type can reach. build.sh re-checks the end result against
# abi-baseline/abi-crcs.txt before handing over a flashable zip.
#
# NEVER ADD these -- each changes a struct layout the vendor modules were built
# against, and no KABI reserve slot can repair them:
#   CONFIG_CGROUP_DEVICE / CONFIG_CGROUP_PIDS   css_set.subsys[] is a fixed
#       array sized by CGROUP_SUBSYS_COUNT; 7 -> 9, 295 CRCs change.
#       Cost of leaving them off: containers get no devices/pids controller.
#   CONFIG_NF_TABLES                            struct net gains
#       netns_nftables nft; every exported symbol taking struct net* changes.
#   CONFIG_BRIDGE_NETFILTER                     adds nf_bridge to struct
#       sk_buff/net_device.
#   CONFIG_BLK_DEV_THROTTLING / CONFIG_CFS_BANDWIDTH / CONFIG_VXLAN
#       struct changes, never ABI-verified on this device.
#
# CONFIG_SYSVIPC is on, and that is only safe because scripts/patches.sh applies
# GKI-5.10-sysvipc_kabi_6_7_8.patch first: it moves sysvsem/sysvshm into the
# ANDROID_KABI_RESERVE() slots task_struct already carries, so genksyms still
# reads `u64 android_kabi_reserved6/7/8` -- byte-identical to the ROM -- and the
# CRCs hold still. The same trick covers CONFIG_POSIX_MQUEUE, which SYSVIPC
# switches on for free (POSIX_MQUEUE is `default y` under it), parking
# user_struct.mq_bytes in slot 1. SYSVIPC, POSIX_MQUEUE and their two patches
# move together: drop either patch and this is the 725-CRC failure that parks
# the device on the logo. build.sh refuses to build if the fixups are missing.
#
# Names to be careful with:
#   CONFIG_NETFILTER_XT_TARGET_REJECT does not exist on a 5.10 tree -- that
#       spelling is a 6.x one. Here it is CONFIG_IP_NF_TARGET_REJECT and
#       CONFIG_IP6_NF_TARGET_REJECT, already on in the ROM, so UFW's
#       `-j REJECT` works as-is. A symbol that does not exist is dropped
#       silently by olddefconfig, which is how a "required" option can look
#       applied while doing nothing at all.
#   CONFIG_NETFILTER_XT_MATCH_RECENT and CONFIG_NETFILTER_XT_SET both
#       `depends on NETFILTER_ADVANCED`. It is =y on this tree; without it
#       neither would even be selectable.
#   Everything is =y, not =m, on purpose: package.sh ships only Image in the
#       AnyKernel3 zip, so a driver built as a module would not exist on the
#       device at all.
#   CONFIG_DEVTMPFS is quirkier than it looks. The ROM runs with it off and
#       Android's init mounts its own tmpfs on /dev, which ueventd then
#       populates, so this only registers the filesystem type for containers;
#       DEVTMPFS_MOUNT is pinned off so the boot-time /dev path is untouched.
#
# xtables (iptables-legacy) is built in on this kernel, so Docker's bridge/NAT
# works; switch a chroot's iptables to the legacy backend if it defaults to nft.
EXTRA_DEFCONFIG=CONFIG_CGROUPS=y CONFIG_CGROUP_FREEZER=y CONFIG_CGROUP_SCHED=y CONFIG_CPUSETS=y CONFIG_MEMCG=y CONFIG_CGROUP_CPUACCT=y CONFIG_BLK_CGROUP=y CONFIG_NAMESPACES=y CONFIG_NET_NS=y CONFIG_PID_NS=y CONFIG_UTS_NS=y CONFIG_USER_NS=y CONFIG_SYSVIPC=y CONFIG_IPC_NS=y CONFIG_POSIX_MQUEUE=y CONFIG_POSIX_MQUEUE_SYSCTL=y CONFIG_DEVTMPFS=y CONFIG_DEVTMPFS_MOUNT=n CONFIG_TMPFS_XATTR=y CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y CONFIG_NETFILTER_XT_TARGET_LOG=y CONFIG_NETFILTER_XT_MATCH_RECENT=y CONFIG_IP_NF_TARGET_REJECT=y CONFIG_IP6_NF_TARGET_REJECT=y CONFIG_IP_SET=y CONFIG_IP_SET_HASH_IP=y CONFIG_IP_SET_HASH_NET=y CONFIG_NETFILTER_XT_SET=y CONFIG_VETH=y CONFIG_BRIDGE=y CONFIG_OVERLAY_FS=y CONFIG_SECCOMP=y CONFIG_SECCOMP_FILTER=y CONFIG_CGROUP_BPF=y CONFIG_BPF_SYSCALL=y CONFIG_KEYS=y CONFIG_IKCONFIG=y CONFIG_IKCONFIG_PROC=y CONFIG_PAGE_EXTENSION=y

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false

# Repack a boot.img around the new kernel. SOURCE_BOOT_IMAGE must be a direct
# link to a bootable image for the same device and ROM.
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true

# ===================================================== Droidspaces & NTsync ===
#
# Droidspaces is a container runtime for Android. It needs the SysV IPC stack
# (CONFIG_SYSVIPC plus the IPC namespace) that a vendor defconfig leaves off.
# NTsync is the Windows NT synchronisation primitive driver that Wine/Proton
# containers use; it only landed upstream in 6.14, so it is backported.
#
# Two things are true at once on a 5.10 tree, and both matter:
#   * switching CONFIG_SYSVIPC / CONFIG_POSIX_MQUEUE on adds fields to
#     struct task_struct and struct user_struct;
#   * Android's frozen GKI ABI pins those layouts down, and the prebuilt vendor
#     modules are built against them.
# So the kABI fixups named below are NOT optional here. They park the new fields
# in the ANDROID_KABI_RESERVE() padding the structs already carry, which leaves
# every offset and both struct sizes byte-identical to a kernel built without
# these options. Without them the tree still compiles -- and then hangs on the
# boot splash. scripts/patches.sh has the gory details.

ENABLE_DROIDSPACES=true

# Which ANDROID_KABI_RESERVE() slot set the SYSVIPC fixup claims. Upstream also
# ships 1_2_3 / 3_4_5 / 5_6_7 for the handful of devices that need a different
# set; 6_7_8 is the one that fits 5.10.
DROIDSPACES_SLOT=678

# Wine/Proton NT synchronisation primitives.
ENABLE_NTSYNC=true

# ---------------------------------------------------------- patch sources ---
#
# Override these if an upstream moves a file. The build fails loudly rather than
# quietly producing a kernel without the fixups.

DROIDSPACES_PATCH_BASE=https://raw.githubusercontent.com/Goldzxcbug/Droidspaces_Kernel_patch/main

NTSYNC_BASE_PATCH=https://raw.githubusercontent.com/Goldzxcbug/Droidspaces_Kernel_patch/main/NTsync/ntsync_base.patch
NTSYNC_COMPAT_PATCH=https://raw.githubusercontent.com/Goldzxcbug/Droidspaces_Kernel_patch/main/NTsync/ntsync_compat_android12-5.10.patch

# 5.10 kABI fixups. Both are required: the first covers struct user_struct
# (CONFIG_POSIX_MQUEUE), the second struct task_struct (CONFIG_SYSVIPC).
DROIDSPACES_KABI_PATCH_5_10=https://raw.githubusercontent.com/Goldzxcbug/Droidspaces_Kernel_patch/main/GKI/5.10/GKI_5.10_posix.patch
DROIDSPACES_KABI_SYSVIPC_PATCH_5_10=https://raw.githubusercontent.com/Goldzxcbug/Droidspaces_Kernel_patch/main/GKI/5.10/GKI-5.10-sysvipc_kabi_6_7_8.patch
